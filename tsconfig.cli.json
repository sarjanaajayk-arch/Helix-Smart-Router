{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "jsx": "react-jsx",

    "rootDir": "./src",
    "outDir": "./dist/cli",

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    "allowJs": true,
    "skipLibCheck": true,

    "isolatedModules": true,
    "noEmit": false,

    "forceConsistentCasingInFileNames": true
  },

  "include": [
    "src/cli/**/*",
    "src/config/**/*",
    "src/orchestrator/**/*",
    "src/providers/**/*",
    "src/registry/**/*",
    "src/services/**/*",
    "src/models/**/*",
    "src/metrics/**/*",
    "src/types/**/*",
    "src/utils/**/*",
    "src/validation/**/*"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}